<?xml version="1.0" encoding="utf-8"?>
<!--
  Melody Quest home header: big left-aligned greeting with the profile picture
  tucked on the right as a rounded square.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/melody_screen_margin"
    android:paddingEnd="@dimen/melody_screen_margin"
    android:paddingTop="12dp"
    android:paddingBottom="4dp">

    <com.google.android.material.textview.MaterialTextView
        android:fontFamily="?attr/melodyDisplayFont"
        app:fontFamily="?attr/melodyDisplayFont"
        android:id="@+id/text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true"
        android:text="@string/welcome"
        android:textAppearance="@style/TextAppearance.Melody.Eyebrow"
        android:textColor="?android:attr/textColorSecondary"
        app:layout_constraintEnd_toStartOf="@+id/userImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Welcome," />

    <com.google.android.material.textview.MaterialTextView
        android:fontFamily="?attr/melodyDisplayFont"
        app:fontFamily="?attr/melodyDisplayFont"
        android:id="@+id/titleWelcome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="12dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:padding="0dp"
        android:textAppearance="@style/TextAppearance.Melody.Greeting"
        android:textColor="?android:attr/textColorPrimary"
        app:layout_constraintEnd_toStartOf="@+id/userImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text"
        tools:text="@tools:sample/first_names" />

    <code.name.monkey.retromusic.views.RetroShapeableImageView
        android:id="@+id/userImage"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:scaleType="centerCrop"
        android:transitionName="user_image"
        app:layout_constraintBottom_toBottomOf="@+id/titleWelcome"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/text"
        app:circleShape="false"
        app:retroCornerSize="16dp"
        tools:srcCompat="@tools:sample/avatars" />
</androidx.constraintlayout.widget.ConstraintLayout>
